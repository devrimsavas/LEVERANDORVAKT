# Copy to .env.local and adjust. Read only by the Next server, never sent
# to the browser.

# Where the Leverandørvakt API (the Express backend) runs
API_URL=http://localhost:3000

# The header a hosting platform puts the visitor's address in, sent on to the
# API for its rate limits: x-real-ip on Vercel, cf-connecting-ip behind
# Cloudflare. Empty: the first address in X-Forwarded-For.
CLIENT_IP_HEADER=
