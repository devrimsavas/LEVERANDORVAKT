# Settings for the API in the web app's end-to-end tests (no secrets).
# Read instead of .env when the tests start the API; a variable already
# set in the environment wins, e.g. DATABASE_URL in CI.
PORT=3100
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leverandorvakt_e2e
JWT_SECRET=e2e-only-secret-not-used-anywhere-else
JWT_EXPIRES_IN=1h
ADMIN_EMAIL=admin@e2e.example.com
ADMIN_PASSWORD=AdminE2eSecure2026
ADMIN_FIRST_NAME=Ada
ADMIN_LAST_NAME=Admin
# The jobs only run when the tests ask for them
CHANGE_DETECTION_INTERVAL_MINUTES=0
ACCOUNTS_CHECK_INTERVAL_HOURS=0
# The language model is the fake one in fakeServices.ts
AI_PROVIDER=ollama
OLLAMA_HOST=http://ollama.test
OLLAMA_MODEL=e2e
OLLAMA_API_KEY=
GEMINI_API_KEY=
AI_TIMEOUT_SECONDS=10
ASSISTANT_DAILY_LIMIT=3
E2E_CONTROL_PORT=3199
# Rate limits: the tests register many users from one address, so only the
# per-account login limit is kept low, for security.spec.ts
REGISTRATIONS_PER_ADDRESS=1000
LOGIN_FAILURES_PER_ADDRESS=1000
REQUESTS_PER_ADDRESS=100000
LOGIN_FAILURES_PER_ACCOUNT=5
PASSWORD_RESETS_PER_ACCOUNT=1000
PASSWORD_RESETS_PER_ADDRESS=1000
# Emails go to the fake Resend in fakeServices.ts; the links point at the
# web app the tests run
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_e2e_key
EMAIL_FROM=Leverandørvakt <e2e@example.com>
WEB_APP_URL=http://localhost:3101
