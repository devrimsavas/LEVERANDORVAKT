PORT=3000
DATABASE_URL=postgres://postgres:password@localhost:5432/leverandorvakt
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d



ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

CHANGE_DETECTION_INTERVAL_MINUTES=10
ACCOUNTS_CHECK_INTERVAL_HOURS=24

# Rate limits (the defaults are shown). Failed logins are counted per account
# and per address in 15 minutes, new accounts per address in an hour, and all
# API requests per address in 15 minutes.
LOGIN_FAILURES_PER_ACCOUNT=10
LOGIN_FAILURES_PER_ADDRESS=30
REGISTRATIONS_PER_ADDRESS=10
REQUESTS_PER_ADDRESS=1500
# Proxies whose X-Forwarded-For is trusted for the client's address. The default
# trusts this machine and private networks (the web app, Docker); a hosting
# platform may need a number of hops instead, e.g. 1.
TRUST_PROXY=loopback, linklocal, uniquelocal
# Password reset emails per account and per address in an hour
PASSWORD_RESETS_PER_ACCOUNT=5
PASSWORD_RESETS_PER_ADDRESS=20
# Wrong passwords per user in 15 minutes when changing the password or
# deleting the account
PASSWORD_CHECK_FAILURES_PER_ACCOUNT=10

# Email. EMAIL_PROVIDER is "log" (write emails to the console, the default) or
# "resend" (send them with https://resend.com, needs RESEND_API_KEY).
# onboarding@resend.dev only delivers to the address the Resend account was made
# with; verify your own domain in Resend to send to anyone.
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Leverandørvakt <onboarding@resend.dev>
# Where the web app runs, for the links in emails
WEB_APP_URL=http://localhost:3001

# AI assistant. AI_PROVIDER is "ollama" or "gemini"; leave it empty to turn the assistant off.
AI_PROVIDER=ollama
AI_TIMEOUT_SECONDS=60
ASSISTANT_DAILY_LIMIT=20
# Ollama: local server, or https://ollama.com with an API key for Ollama Cloud
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3
OLLAMA_API_KEY=
# Gemini: API key from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=
